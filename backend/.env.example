# ==============================================================================
# BHRATRITYA FOUNDATION — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port (Default: 8000, or provided dynamically by hosting platform $PORT)
PORT=8000

# Production PostgreSQL (Neon) Database Connection URI
# Example: postgresql://<user>:<password>@<neon-pooler-host>/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require

# JWT Cryptographic Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_secret_key_for_production

# Allowed CORS Origins for Frontend Access (Comma-separated URLs)
# Include your Firebase Hosting domain once deployed:
# Example: https://foundation-management-system.web.app,https://foundation-management-system.firebaseapp.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary Media Storage (Backend Only - NEVER expose to Frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
