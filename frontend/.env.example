# ==============================================================================
# BHRATRITYA FOUNDATION - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
#
# Production API Base URL for the FastAPI Backend REST API.
# When deployed, set this to your backend domain or Cloudflare Tunnel URL:
# Example: https://awesome-polls-commodities-substances.trycloudflare.com
#
# NOTE: The frontend communicates ONLY with the FastAPI backend API via HTTPS.
# The frontend NEVER connects directly to Neon PostgreSQL.
# ==============================================================================
VITE_API_URL=https://your-backend-domain.example.com
